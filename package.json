{
  "name": "van-reservation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "format": "biome format --write",
    "typecheck": "tsc --noEmit",
    "test": "VITE_CONFIG_NATIVE_IGNORE_WARNING=true vitest run --config vitest.config.ts",
    "test:watch": "VITE_CONFIG_NATIVE_IGNORE_WARNING=true vitest --config vitest.config.ts",
    "test:int": "VITE_CONFIG_NATIVE_IGNORE_WARNING=true vitest run --config vitest.int.config.ts",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "kysely migrate latest",
    "db:migrate:make": "kysely migrate make",
    "db:seed": "kysely seed run --specific 20260804000000_admin_whitelist && kysely seed run --specific 20260827000000_fleet_roster",
    "db:seed:dev": "kysely seed run --specific 20260807000000_dev_dataset",
    "db:codegen": "kysely-codegen --dialect postgres --out-file ./src/modules/db/types.d.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.1103.0",
    "@base-ui/react": "^1.6.0",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "@smithy/node-http-handler": "^4.11.3",
    "@tanstack/react-query": "^5.101.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jose": "^6.2.7",
    "kysely": "^0.29.4",
    "lucide-react": "^1.28.0",
    "motion": "^12.43.0",
    "next": "16.2.12",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "3.8.0",
    "shadcn": "^4.16.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/pg": "^8.20.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "dotenv": "^17.4.2",
    "jsdom": "^30.0.1",
    "kysely-codegen": "^0.20.0",
    "kysely-ctl": "^0.21.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
