DATABASE_URL=postgres://van:van@localhost:5433/van_reservation
TEST_DATABASE_URL=postgres://van:van@localhost:5433/van_reservation_test
#
# Alternative to the two URLs above, for a server handed to you as discrete
# values: leave both blank and set these instead. DATABASE_URL wins whenever it
# is set — including when your SHELL exports it, which silently outranks this
# file, so check `echo "$DATABASE_URL"` if composition seems ignored.
#   DB_HOST=      DB_PORT=      DB_NAME=      DB_USER=      DB_PASSWORD=
# DB_SCHEMA puts every table in that schema instead of `public`, and points the
# integration tests at a `<schema>_test` sibling — the only isolation available
# where you cannot CREATE DATABASE. Without it, tests use a `<name>_test`
# database instead.
#   DB_SCHEMA=
# DB_SSLMODE is passed through verbatim. Use `no-verify` for a server with a
# private CA: `require` is treated as verify-full and fails on an untrusted
# certificate.
#   DB_SSLMODE=
# Deliberately too short to pass `z.string().min(32)`. A verbatim copy of this
# file must FAIL to boot rather than run on a secret that is public in the repo.
# Generate one with: openssl rand -base64 48
SESSION_SECRET=
# `stub` selects the dev fixture provider (Domain ID → fixture identity, no
# password check). `cgsauth` authenticates against the CGS Associate
# Authentication API and requires CGS_AUTH_API_KEY below.
AUTH_MODE=stub
# CGS Associate Authentication API. Defaults to production; use
# https://uat.teamcgs.io for pre-prod testing. Only consulted when
# AUTH_MODE=cgsauth.
CGS_AUTH_BASE_URL=https://teamcgs.io
# The x-api-key issued to this application by the CGS platform team. Server-side
# only — never exposed to the browser. Required when AUTH_MODE=cgsauth; leave
# blank in stub mode. Keep the real value out of the repo (set it in `.env`).
CGS_AUTH_API_KEY=
APP_URL=http://localhost:3000
# Email transport. `stub` captures outbound mail without sending (the default,
# for dev/test); `ses` sends through Amazon SES. The stub refuses to run in
# production, so a prod deploy MUST set EMAIL_MODE=ses — otherwise it fails loudly
# at first send rather than silently dropping mail.
#
# READ THIS IF NO MAIL IS ARRIVING: `stub` sends NOTHING. Notifications are
# still queued, rendered and marked `sent` in notification_outbox, and the
# dispatcher reports success — the message is simply captured in memory instead
# of handed to a provider. An OMITTED EMAIL_MODE is `stub`, so an environment
# that never set it looks healthy in every log and delivers no mail at all. Set
# `ses` plus the four values below to actually send.
EMAIL_MODE=stub
# AWS_REGION and EMAIL_FROM are required when EMAIL_MODE=ses. The CREDENTIALS
# below are optional: leave all three blank and the AWS SDK falls back to its
# default credential chain — a named profile, an SSO session, or an instance /
# task role. That is what a deployment should use, since those refresh
# themselves; explicit keys expire and have to be re-pasted.
#
# THIS FILE IS COMMITTED. Real values belong in `.env`, which is gitignored.
AWS_REGION=
# Set BOTH of these or NEITHER — half a pair is refused at boot, because the SDK
# would silently ignore it and authenticate as somebody else through the chain.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# REQUIRED for temporary credentials, which is what AWS SSO and assume-role
# issue: their key starts `ASIA` rather than `AKIA`. Without the token SES
# answers 403 on every send, and the mail queues forever instead of arriving.
# Leave blank for a permanent key.
AWS_SESSION_TOKEN=
# A verified SES sender identity, e.g. "Van Reservation <no-reply@yourdomain.com>".
EMAIL_FROM=
# Optional Reply-To for outbound mail (e.g. an OPS Support inbox).
EMAIL_REPLY_TO=
# Addresses copied on EVERY outbound message — the requestor's own booking,
# approval, rejection and cancellation mail included, not just the admin
# notices. Comma-separated; blanks and surrounding spaces are dropped, and
# anyone already on the To or Cc is not copied twice.
#
# Applied inside `sendEmail`, the one function every message passes through, so
# a new template or a new notification cannot omit it. Leave blank to copy
# nobody (what dev and test want).
EMAIL_ALWAYS_CC=

# Guards GET /api/internal/dispatch-outbox, the notification-queue sweeper.
# LEAVING THIS BLANK MAKES THE ENDPOINT 404 — an endpoint that drains the mail
# queue must not be reachable by default. Minimum 16 characters. Set it in any
# environment that has a scheduler calling the sweeper (every 5-15 minutes is
# ample; the endpoint is idempotent, so calling it more often is harmless).
DISPATCH_SECRET=
